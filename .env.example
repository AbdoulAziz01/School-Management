APP_NAME=EduManager
PLATFORM_NAME=EduManager
DEFAULT_SCHOOL_NAME="Établissement principal"

# Super administrateur plateforme (créé à la migration si renseigné)
SUPER_ADMIN_NAME="Super Administrateur"
SUPER_ADMIN_EMAIL=superadmin@example.com
SUPER_ADMIN_PASSWORD=ChangeMe-SuperAdmin-2026!
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# MySQL local (si vous n'utilisez pas sqlite) :
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=school_management_system
# DB_USERNAME=root
# DB_PASSWORD=

# InfinityFree / htdocs : guidé complet dans deploy/infinityfree/instructions.txt
# DB_CONNECTION=mysql
# DB_HOST=sqlXXX.infinityfree.com
# DB_PORT=3306
# DB_DATABASE=epiz_XXX_ecole
# DB_USERNAME=epiz_XXX
# DB_PASSWORD=...
# SESSION_DRIVER=file
# CACHE_STORE=file
# QUEUE_CONNECTION=sync

# Laravel Cloud (PostgreSQL) : DB_* est rempli automatiquement quand la base est attachée.
# En local, ne change .env que si tu veux pointer vers cette base (credentials depuis Cloud → Settings).
# DB_CONNECTION=pgsql
# DB_HOST=....pg.laravel.cloud
# DB_PORT=5432
# DB_DATABASE=main
# DB_USERNAME=...
# DB_PASSWORD=...

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail : Brevo (SMTP) — fonctionne en local et en production ---
# 1. Compte https://www.brevo.com → Paramètres → SMTP → générer une clé SMTP (xsmtpsib-...)
# 2. Vérifier l'expéditeur (email utilisé dans MAIL_FROM_ADDRESS)
# 3. MAIL_PASSWORD = clé « xsmtpsib-... » (onglet Clés SMTP), PAS le mot de passe maître de l’assistant
MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
# smtp = port 587 (STARTTLS, Brevo) | smtps = port 465
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Sans Brevo (dev) : écrire les mails dans storage/logs/laravel.log
# MAIL_MAILER=log

# Identifiants professeur : false = pas d'email Brevo, l'admin voit le mot de passe à l'écran
TEACHER_SEND_CREDENTIALS_EMAIL=false

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Botpress / API lecture statistiques (Bearer token obligatoire sur /api/bot/school/*)
SCHOOL_BOT_SECRET=
# Optionnel — seuil moyenne générale « admis » (échelle généralement /20). Défaut 10.
# SCHOOL_BOT_PASSING_GRADE_MIN=10

VITE_APP_NAME="${APP_NAME}"
# URL du microservice Node.js (widget React AgentChat)
# Widget React Assistant IA → microservice Node (POST /api/agent, port 3000)
VITE_AI_AGENT_URL=http://localhost:3000

# Sauvegarde automatique (spatie/laravel-backup) : e-mail de notification succès/échec
BACKUP_NOTIFICATION_EMAIL=azelie.backup@gmail.com
# Mot de passe de chiffrement de l'archive de backup (laisser vide = pas de chiffrement)
BACKUP_ARCHIVE_PASSWORD=

# Messages WhatsApp automatiques aux parents (absences) : désactivés pour l'instant
NOTIFY_PARENTS_ENABLED=false
