@startuml
!theme toy
title Diagramme d'Activite - Gestion des inscriptions par l'Administrateur

skinparam ActivityBackgroundColor #FFF8DC
skinparam ActivityBorderColor #444444
skinparam ActivityDiamondBackgroundColor #FFE4B5
skinparam ActivityDiamondBorderColor #8B4513
skinparam NoteBackgroundColor #FFFACD
skinparam ArrowColor #555555

|#FFFFFF|Administrateur|
|#F5F5DC|Systeme EduManager|
|#FFF0F5|Base de donnees|

|Administrateur|
start
:Se rend sur /login;
:Saisit identifiant + mot de passe;

|Systeme EduManager|
:LoginRequest::authenticate();

if (Identifiants valides ?) then (non)
  |Administrateur|
  :Affiche "Identifiants invalides";
  stop
else (oui)
endif

if (role == 'admin' ?) then (non)
  :Redirige vers son propre dashboard;
  stop
else (oui)
endif

:Redirige vers /admin/dashboard;

|Administrateur|
:Consulte le tableau de bord\n(voit le nombre d'inscriptions en attente);
:Clique sur "Inscriptions en attente";

|Systeme EduManager|
:PendingRegistrationController::pending();

|Base de donnees|
:SELECT * FROM users\nWHERE status = 'pending'\nORDER BY created_at DESC;

|Systeme EduManager|
:Charge la relation 'class';
:Renvoie la vue\nadmin.registrations.pending;

|Administrateur|
:Visualise la liste des demandes\n(nom, identifiant, role, classe souhaitee,\ndate d'inscription, matieres pour profs);

if (Des demandes en attente ?) then (non)
  :Affiche "Aucune demande en attente";
  stop
else (oui)
endif

:Selectionne une demande;
:Examine les informations du candidat;

if (Profil conforme aux criteres ?) then (non)
  :Clique sur le bouton "Rejeter";

  |Systeme EduManager|
  :PATCH /admin/registrations/{user}/reject;
  :PendingRegistrationController::reject($user);
  :$user->status = 'rejected';
  :$user->save();

  |Base de donnees|
  :UPDATE users\nSET status = 'rejected'\nWHERE id = ?;

  |Systeme EduManager|
  note right
    Le compte reste en base
    mais la connexion sera
    refusee par LoginRequest
    (RG-06)
  end note

  |Administrateur|
  :Recoit flash('success')\n"Inscription rejetee avec succes";

else (oui)
  :Clique sur le bouton "Approuver";
  :Selectionne une classe\ndans le formulaire modal;
  :Soumet le formulaire;

  |Systeme EduManager|
  :PATCH /admin/registrations/{user}/approve\n{class_id};
  :PendingRegistrationController::approve();
  :validate(['class_id' => 'required|exists:classes,id']);

  if (Classe existante et valide ?) then (non)
    |Administrateur|
    :Recoit flash('error')\n"Classe invalide";
    stop
  else (oui)
  endif

  |Systeme EduManager|
  :DB::beginTransaction();
  :$user->update([\n  'status' => 'approved',\n  'class_id' => $request->class_id\n]);

  |Base de donnees|
  :UPDATE users\nSET status = 'approved',\n    class_id = ?\nWHERE id = ?;

  |Systeme EduManager|
  :DB::commit();

  note right
    Le compte est desormais actif :
    - l'eleve peut se connecter
    - il est rattache a sa classe
    - il acquiert les relations
      (notes, presences, bulletins)
  end note

  |Administrateur|
  :Recoit flash('success')\n"Inscription approuvee avec succes";
endif

:Redirection vers\n/admin/pending-registrations;

if (D'autres demandes a traiter ?) then (oui)
  -> Oui;
  |Administrateur|
  :Selectionne une autre demande;
  note right
    Retour a l'etape de traitement
    d'une demande individuelle
  end note
else (non)
  :Retourne au dashboard;
  stop
endif

@enduml
