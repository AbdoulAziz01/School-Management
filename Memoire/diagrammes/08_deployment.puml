@startuml
title Diagramme de Deploiement - EduManager
skinparam node {
  BackgroundColor #FEFEFE
  BorderColor #444
}

node "Poste client" as Client {
  artifact "Navigateur Web\n(Chrome / Firefox / Edge)" as Browser
}

cloud "Internet / Reseau local" as Net

node "Serveur Web\n(Windows + XAMPP / Linux + Nginx)" as Web <<server>> {
  component "Apache / Nginx\n(port 80/443)" as HTTP
  component "PHP-FPM 8.2" as PHP
  artifact "Application Laravel 12\n(EduManager)" as Laravel {
    component "Routing" as R
    component "Controllers" as C
    component "Eloquent Models" as M
    component "Blade Views" as V
    component "Middleware\n(Auth, Role)" as MW
  }
  folder "storage/" as Storage {
    artifact "app/public\n(photos profil)"
    artifact "logs/\nlaravel.log"
    artifact "framework/\nsessions, views, cache"
  }
}

node "Service IA\n(Python 3)" as AI <<server>> {
  component "Flask / FastAPI\n(port 5000)" as Flask
  artifact "app_ai_final.py" as AIApp
}

node "Serveur de donnees" as DBNode <<server>> {
  database "MySQL / MariaDB\n(port 3306)" as MySQL {
    artifact "BDD : edumanager"
  }
}

Browser -- Net : HTTPS
Net -- HTTP

HTTP --> PHP
PHP --> Laravel
Laravel --> Storage
Laravel --> MySQL : PDO / Eloquent\nTCP 3306
Laravel --> Flask : HTTP POST /chat\n(AI_SERVICE_URL)
Flask --> MySQL : Lecture schema\n(optionnel)

note right of Laravel
  Middleware :
  - auth
  - role:admin
  - StudentMiddleware
  - TeacherMiddleware
end note

note right of MySQL
  16 tables metier :
  users, classes, levels,
  academic_years, subjects,
  teacher_assignments,
  teacher_subjects, class_teacher,
  class_subject, grades,
  attendances, schedules,
  timetables, assignments,
  events, class_groups, ...
end note

@enduml
