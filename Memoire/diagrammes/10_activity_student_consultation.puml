@startuml
!theme toy
title Diagramme d'Activite - Parcours de consultation de l'Eleve

skinparam ActivityBackgroundColor #E8F5E9
skinparam ActivityBorderColor #1B5E20
skinparam ActivityDiamondBackgroundColor #FFF9C4
skinparam ActivityDiamondBorderColor #F57F17
skinparam NoteBackgroundColor #F3E5F5
skinparam ArrowColor #424242

|#FFFFFF|Eleve|
|#E3F2FD|Systeme EduManager|
|#FCE4EC|Base de donnees|

|Eleve|
start
:Ouvre le navigateur;
:Se rend sur /login;
:Saisit identifiant ou email\n+ mot de passe;

|Systeme EduManager|
:LoginRequest::authenticate();

if (Identifiants corrects ?) then (non)
  |Eleve|
  :Message "Identifiants invalides";
  stop
else (oui)
endif

if (status == 'approved' ?) then (non)
  if (status == 'pending' ?) then (oui)
    |Eleve|
    :"Compte en attente\nde validation";
    stop
  else (non)
    |Eleve|
    :"Compte rejete par\nl'administration";
    stop
  endif
else (oui)
endif

|Systeme EduManager|
:StudentMiddleware verifie role == 'eleve';
:Redirige vers /student/dashboard;

|Eleve|
:Arrive sur le tableau de bord;

|Systeme EduManager|
:StudentDashboardController::dashboard();

|Base de donnees|
:Grade::where(user_id)->avg('grade');
:Attendance::where(user_id)->count();
:Grade::where(user_id)\n->with('subject')\n->orderBy(created_at desc)\n->take(5);

|Systeme EduManager|
:Calcule moyenne generale,\ntaux de presence,\nrecupere les 5 dernieres notes;
:Renvoie la vue\nstudent.dashboard;

|Eleve|
:Visualise les widgets\n(moyenne, taux de presence,\nnotes recentes, menu lateral);

repeat
  :Choisit une action dans le menu;

  switch (Quelle rubrique ?)

  case ( Consulter les notes )

    :Clique sur "Notes";

    |Systeme EduManager|
    :GET /student/grades;
    :StudentGradesController::index();

    |Base de donnees|
    :$user->grades()\n->with('subject')->get();

    |Systeme EduManager|
    :groupBy('subject.name');

    if (Notes disponibles ?) then (non)
      |Eleve|
      :Affiche "Aucune note\ndisponible";
    else (oui)
      |Systeme EduManager|
      :Pour chaque matiere :\n  avg = grades.avg('grade')\n  coef = subject.coefficient\n  appreciation = getAppreciation(avg);
      :Calcul moyenne generale\n(ponderee par coefficient);
      :Construit gradesEvolution\n(evolution mensuelle);
      :Renvoie vue student.grades;

      |Eleve|
      :Visualise les notes\ngroupees par matiere\navec appreciation (RG-16);
      :Consulte le graphique\nd'evolution;
    endif

  case ( Voir l'emploi du temps )

    :Clique sur "Emploi du temps";

    |Systeme EduManager|
    :GET /student/schedule;
    :StudentScheduleController::index();
    :Calcule les dates\nde debut/fin de semaine\n(Carbon::setISODate);

    if (Donnees reelles disponibles ?) then (non)
      :Charge l'emploi simule\n(getSimulatedSchedule);
    else (oui)
      |Base de donnees|
      :SELECT * FROM schedules\nWHERE class_id = ?\nORDER BY day_of_week, start_time;
      |Systeme EduManager|
      :Groupe par jour de la semaine;
    endif

    :Renvoie vue student.schedule;

    |Eleve|
    :Visualise la grille\nhebdomadaire (Lun-Ven)\navec matieres, horaires,\nprofs et salles;
    :Peut naviguer entre les semaines;

  case ( Verifier les presences )

    :Clique sur "Presences";

    |Systeme EduManager|
    :GET /student/attendance;
    :StudentAttendanceController::index();

    |Base de donnees|
    :$user->attendances()\n->orderBy(date, desc)\n->paginate(15);
    :COUNT par status\n(present, absent, late);

    |Systeme EduManager|
    :Calcule stats :\n  presentDays, absentDays,\n  lateDays, totalDays,\n  attendanceRate (%);

    if (Aucune presence enregistree ?) then (oui)
      :Affiche taux a 0%\net calendrier vide;
    else (non)
      :Prepare calendarEvents\n(couleurs par statut);
    endif

    :Renvoie vue student.attendance;

    |Eleve|
    :Visualise les statistiques,\nle calendrier mensuel colore\net l'historique pagine;

  endswitch

  |Eleve|
  if (Souhaite consulter autre chose ?) then (oui)
    :Retourne au dashboard\n(ou utilise le menu);
  else (non)
    :Clique sur "Se deconnecter";

    |Systeme EduManager|
    :POST /logout;
    :Auth::logout();
    :session()->invalidate();
    :Redirige vers /;
    stop
  endif
repeat while (Session active ?)

@enduml
