@startuml
title Diagramme de Sequence - Affectation Enseignant x Classe x Matiere x Annee
skinparam sequenceArrowThickness 1.2

actor Administrateur as A
participant "Navigateur" as Browser
participant "Middleware\n'role:admin'" as MW
participant "TeacherAssignment\nController" as Ctrl
participant "Policy\n(authorize)" as Pol
participant "TeacherAssignment\n(Model)" as TA
participant "AcademicYear / Class /\nSubject / User" as Rel
database "MySQL" as DB

A -> Browser : Choisit enseignant, annee,\nclasse et matiere
Browser -> MW : POST /admin/teachers/{teacher}/assignments
MW -> MW : Verifie role == 'admin'
MW -> Ctrl : storeAssignment(Request, User $teacher)

Ctrl -> Pol : authorize('create', TeacherAssignment)
Pol --> Ctrl : OK

Ctrl -> Ctrl : validate([academic_year_id,\nclass_id, subject_id])

Ctrl -> Rel : AcademicYear::findOrFail(id)
Rel -> DB : SELECT ... FROM academic_years
DB --> Rel : row
Rel --> Ctrl : AcademicYear

Ctrl -> TA : where(teacher_id,class_id,\nsubject_id,academic_year_id)->exists()
TA -> DB : SELECT COUNT(*) FROM teacher_assignments
DB --> TA : 0
TA --> Ctrl : false (pas de doublon)

Ctrl -> Ctrl : DB::beginTransaction()
Ctrl -> TA : new TeacherAssignment(validated)
Ctrl -> TA : $assignment->teacher_id = $teacher->id
Ctrl -> TA : $assignment->save()
TA -> DB : INSERT INTO teacher_assignments\n(teacher_id, class_id, subject_id,\nacademic_year_id)
DB --> TA : id
TA --> Ctrl : saved

note right of Ctrl
  Contrainte UNIQUE garantit la regle RG-10 :
  un meme enseignant ne peut etre affecte
  deux fois a la meme matiere/classe/annee.
end note

Ctrl -> Ctrl : DB::commit()
Ctrl --> Browser : 302 redirect\n+ flash('Affectation enregistree')
Browser -> A : Retour a la page des affectations

@enduml
